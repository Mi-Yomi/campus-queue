HOST=0.0.0.0
PORT=3001
DATABASE_PATH=./data/queue.sqlite
# Created by npm run setup. Never place passwords in VITE_ variables.
ADMIN_PASSWORD_HASH=
# Exact frontend origins, separated by commas. No trailing slash.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001
# Frontend build only: empty locally (Vite proxies /api).
VITE_API_URL=
# Optional cloud mode. Use only the public publishable key, never service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Only for a static publication before the backend is connected; false locally.
VITE_DEPLOY_PENDING=false
# Enable only with a known, trusted reverse proxy in production.
TRUST_PROXY_HOPS=0
